{{ printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
  xmlns:xhtml="http://www.w3.org/1999/xhtml">
  {{- /* Hugo 管理的全部页面：首页 + 分区 + 内容页 + 分类/标签
         用 site.Pages（而非 .Pages）才能覆盖首页与嵌套内容页，
         历史上 .Pages 导致首页与 herbs/chenxiang 等深层页漏收。 */}}
  {{- $skip := slice "/checklist/" "/search/" }}
  {{- range where site.Pages "Sitemap.Disable" "ne" true }}
  {{- $p := .RelPermalink }}
  {{- if not (in $skip $p) }}
  <url>
    <loc>{{ .Permalink }}</loc>{{ if not .Lastmod.IsZero }}
    <lastmod>{{ safeHTML ( .Lastmod.Format "2006-01-02T15:04:05-07:00" ) }}</lastmod>{{ end }}
    <priority>{{ if .IsHome }}1.0{{ else if .IsSection }}0.9{{ else }}0.7{{ end }}</priority>
  </url>
  {{- end }}{{ end }}
  {{- /* static/ 下的纯静态 HTML 页面（不受 Hugo .Pages 管理）
         清单由 scripts/rebuild_sitemap_extra.py 自动生成，勿手工编辑 */}}
  {{- $base := strings.TrimSuffix "/" .Site.BaseURL }}
  {{- range hugo.Data.sitemap_extra }}
  <url>
    <loc>{{ $base }}{{ .url }}</loc>
    <priority>{{ .priority }}</priority>
  </url>{{ end }}
</urlset>
